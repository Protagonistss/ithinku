{
  "name": "ithinku",
  "version": "1.0.0",
  "description": "ESLint configurations and utilities for modern JavaScript/TypeScript projects",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test:expr": "pnpm -F expr test",
    "build:expr": "pnpm -F expr build",
    "lint:expr": "pnpm -F expr lint",
    "lint:shared": "pnpm -F shared lint",
    "lint": "eslint packages",
    "lint:oxlint": "oxlint -c packages/oxlint-config/index.json .",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:oxfmt": "oxfmt -c packages/oxfmt-config/index.json .",
    "format:oxfmt:check": "oxfmt -c packages/oxfmt-config/index.json --check .",
    "release": "pnpm -r build && pnpm changeset:publish"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Protagonistss/ithinku.git"
  },
  "keywords": [
    "eslint",
    "typescript",
    "javascript",
    "vue",
    "react",
    "config"
  ],
  "author": "huangshan <protagonisths@gmail.com> (https://github.com/Protagonistss)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Protagonistss/ithinku/issues"
  },
  "homepage": "https://github.com/Protagonistss/ithinku#readme",
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@ithinku/eslint-config-base": "workspace:*",
    "@ithinku/eslint-config-ts": "workspace:*",
    "@ithinku/oxfmt-config": "workspace:*",
    "@ithinku/oxlint-config": "workspace:*",
    "@ithinku/prettier-config": "workspace:^",
    "@ithinku/tsconfig": "workspace:*",
    "@types/node": "^20.11.19",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.7.4",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.0.0"
  }
}
