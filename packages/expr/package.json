{
  "name": "@ithinku/expr",
  "version": "0.0.3",
  "description": "A TypeScript expression parser library",
  "keywords": [
    "ast",
    "expression",
    "parser",
    "typescript"
  ],
  "homepage": "https://github.com/Protagonistss/ithinku#readme",
  "bugs": {
    "url": "https://github.com/Protagonistss/ithinku/issues"
  },
  "license": "MIT",
  "author": "huangshan <protagonisths@gmail.com> (https://github.com/Protagonistss)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Protagonistss/ithinku.git",
    "directory": "packages/expr"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "prebuild": "pnpm clean",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "debug": "node --experimental-transform-types --import ./scripts/register-ts.mjs src/index.ts"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.8.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
